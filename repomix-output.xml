<file path="app/global.css">
:root {
  /* Paleta verde bosque */
  --verde-texto: #0f2e1c;
  --verde-primario: #1a7a4c;
  --verde-primario-oscuro: #135c3a;
  --texto-secundario: #5b7568;
  --verde-niebla: #eaf5ee;
  --fondo-base: #f7faf8;

  /* Cristal */
  --cristal-bg: rgba(255, 255, 255, 0.55);
  --cristal-bg-fuerte: rgba(255, 255, 255, 0.72);
  --cristal-borde: rgba(26, 122, 76, 0.14);
  --sombra-cristal: 0 8px 32px rgba(15, 46, 28, 0.08);

  /* Posiciones (tonos editoriales, no saturados) */
  --por: #7c5cbf;
  --def: #b8863b;
  --med: #3f7cac;
  --del: #c1503f;

  --radio-lg: 20px;
  --radio-md: 14px;
  --radio-sm: 10px;
}

* {
  box-sizing: border-box;
}

html,
body {
  margin: 0;
  padding: 0;
}

body {
  font-family: var(--font-manrope), sans-serif;
  background: var(--fondo-base);
  color: var(--verde-texto);
  min-height: 100vh;
  position: relative;
}

/* Manchas de fondo — dan textura real al backdrop-blur */
.fondo-manchas {
  position: fixed;
  inset: 0;
  z-index: -1;
  overflow: hidden;
}
.mancha {
  position: absolute;
  border-radius: 50%;
  filter: blur(70px);
}
.mancha-1 {
  top: -12%;
  left: -10%;
  width: 420px;
  height: 420px;
  background: radial-gradient(circle, var(--verde-niebla), transparent 70%);
}
.mancha-2 {
  bottom: -18%;
  right: -8%;
  width: 520px;
  height: 520px;
  background: radial-gradient(circle, rgba(26, 122, 76, 0.16), transparent 70%);
}
.mancha-3 {
  top: 38%;
  left: 58%;
  width: 320px;
  height: 320px;
  background: radial-gradient(
    circle,
    rgba(234, 245, 238, 0.95),
    transparent 70%
  );
}

.contenedor {
  max-width: 720px;
  margin: 0 auto;
  padding: 48px 20px 80px;
  position: relative;
  z-index: 1;
}

.marca {
  display: flex;
  align-items: center;
  gap: 8px;
  font-family: var(--font-fraunces), serif;
  font-weight: 600;
  font-size: 0.95rem;
  color: var(--verde-primario);
  margin-bottom: 18px;
  letter-spacing: 0.01em;
}
.marca .punto {
  width: 7px;
  height: 7px;
  border-radius: 50%;
  background: var(--verde-primario);
  display: inline-block;
}

h1 {
  font-family: var(--font-fraunces), serif;
  font-weight: 600;
  font-size: clamp(1.7rem, 4vw, 2.3rem);
  letter-spacing: -0.01em;
  margin: 0 0 6px;
  color: var(--verde-texto);
}
h2 {
  font-family: var(--font-fraunces), serif;
  font-weight: 500;
  font-size: 1.15rem;
  margin: 0 0 4px;
  color: var(--verde-texto);
}

.subtitulo {
  color: var(--texto-secundario);
  margin: 0 0 28px;
  font-size: 0.98rem;
  line-height: 1.5;
}

/* Tarjeta de cristal */
.tarjeta {
  background: var(--cristal-bg);
  backdrop-filter: blur(20px);
  -webkit-backdrop-filter: blur(20px);
  border: 1px solid var(--cristal-borde);
  border-radius: var(--radio-lg);
  padding: 22px;
  margin-bottom: 16px;
  box-shadow: var(--sombra-cristal);
}

/* Botones */
button,
.boton-primario {
  background: var(--verde-primario);
  color: #fff;
  border: none;
  padding: 13px 20px;
  border-radius: var(--radio-md);
  font-family: var(--font-manrope), sans-serif;
  font-weight: 700;
  font-size: 0.95rem;
  cursor: pointer;
  width: 100%;
  transition:
    background 0.15s ease,
    transform 0.1s ease;
}
button:hover,
.boton-primario:hover {
  background: var(--verde-primario-oscuro);
}
button:active {
  transform: translateY(1px);
}
button:disabled {
  opacity: 0.5;
  cursor: not-allowed;
}

.boton-secundario {
  background: transparent;
  color: var(--verde-primario);
  border: 1.5px solid var(--verde-primario);
  padding: 11px 20px;
  border-radius: var(--radio-md);
  font-weight: 700;
  font-size: 0.9rem;
  cursor: pointer;
  width: 100%;
}
.boton-secundario:hover {
  background: var(--verde-niebla);
}

/* Inputs — reemplazan los estilos inline del admin */
.campo-input,
.campo-select {
  width: 100%;
  padding: 12px 14px;
  border-radius: var(--radio-md);
  border: 1px solid var(--cristal-borde);
  background: var(--cristal-bg-fuerte);
  color: var(--verde-texto);
  font-family: var(--font-manrope), sans-serif;
  font-size: 0.95rem;
  outline: none;
  transition:
    border-color 0.15s ease,
    box-shadow 0.15s ease;
}
.campo-input:focus,
.campo-select:focus {
  border-color: var(--verde-primario);
  box-shadow: 0 0 0 3px rgba(26, 122, 76, 0.12);
}
.campo-input::placeholder {
  color: var(--texto-secundario);
}

.fila-atributo {
  display: flex;
  align-items: center;
  gap: 14px;
  margin: 6px 0;
}
.fila-atributo label {
  width: 110px;
  font-size: 0.85rem;
  color: var(--texto-secundario);
  font-weight: 500;
}

.fila-atributo input[type="range"] {
  flex: 1;
  -webkit-appearance: none;
  appearance: none;
  height: 4px;
  border-radius: 4px;
  background: var(--verde-niebla);
  outline: none;
}
.fila-atributo input[type="range"]::-webkit-slider-thumb {
  -webkit-appearance: none;
  width: 18px;
  height: 18px;
  border-radius: 50%;
  background: var(--verde-primario);
  border: 3px solid #fff;
  box-shadow: 0 2px 6px rgba(15, 46, 28, 0.25);
  cursor: pointer;
}
.fila-atributo input[type="range"]::-moz-range-thumb {
  width: 18px;
  height: 18px;
  border-radius: 50%;
  background: var(--verde-primario);
  border: 3px solid #fff;
  cursor: pointer;
}
.valor-atributo {
  width: 22px;
  text-align: right;
  font-weight: 700;
  color: var(--verde-primario);
  font-variant-numeric: tabular-nums;
}

/* Chips de posición */
.chip {
  display: inline-block;
  font-size: 0.68rem;
  font-weight: 700;
  padding: 3px 10px;
  border-radius: 999px;
  margin-left: 8px;
  color: #fff;
  letter-spacing: 0.02em;
  vertical-align: middle;
}
.chip-DEL {
  background: var(--del);
}
.chip-MED {
  background: var(--med);
}
.chip-DEF {
  background: var(--def);
}
.chip-POR {
  background: var(--por);
}

.equipos-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 14px;
}
@media (max-width: 560px) {
  .equipos-grid {
    grid-template-columns: 1fr;
  }
}

.jugador-fila {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 10px 0;
  border-bottom: 1px solid var(--cristal-borde);
  font-size: 0.9rem;
}
.jugador-fila:last-child {
  border-bottom: none;
}

.total-equipo {
  font-family: var(--font-fraunces), serif;
  font-size: 1.3rem;
  font-weight: 600;
  text-align: center;
  margin-bottom: 10px;
  color: var(--verde-texto);
}

a {
  color: var(--verde-primario);
  text-decoration: none;
}

.link-jugador {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 11px 0;
  border-bottom: 1px solid var(--cristal-borde);
  font-size: 0.85rem;
  word-break: break-all;
  gap: 10px;
