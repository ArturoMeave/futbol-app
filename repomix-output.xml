  --def-texto: #92400e;
  --por-bg: #e9d5ff;
  --por-texto: #6b21a8;

  /* Colores equipo */
  --equipo-a: #0f9d58;
  --equipo-b: #2d7d46;

  /* Radios grandes */
  --radio-lg: 28px;
  --radio-md: 18px;
  --radio-sm: 12px;

  /* Variables legacy que usa el código existente */
  --verde-primario: #0f9d58;
  --verde-primario-oscuro: #0b7d46;
  --verde-texto: var(--texto);
  --verde-niebla: #eaf5ee;
  --texto-suave-deprecated: var(--texto-suave);

  /* Referencias usadas por AnilloProgreso y navegación */
  --acento-glow: rgba(15, 157, 88, 0.35);
  --acento-oscuro: var(--acento-hover);
  --texto-secundario: var(--texto-suave);
  --font-sora: var(--font-fraunces), serif;
}

* {
  box-sizing: border-box;
  margin: 0;
  padding: 0;
}

html {
  scroll-behavior: smooth;
}

body {
  font-family:
    var(--font-manrope),
    -apple-system,
    BlinkMacSystemFont,
    sans-serif;
  background: var(--fondo);
  color: var(--texto);
  min-height: 100vh;
  line-height: 1.5;
  -webkit-font-smoothing: antialiased;
}

/* ── Fondo con manchas borrosas animadas ── */
.fondo-manchas {
  position: fixed;
  inset: 0;
  z-index: -1;
  overflow: hidden;
  pointer-events: none;
}

.mancha {
  position: absolute;
  border-radius: 50%;
  filter: blur(90px);
  opacity: 0.45;
}

.mancha-1 {
  top: -12%;
  left: -10%;
  width: 520px;
  height: 520px;
  background: radial-gradient(
    circle,
    rgba(15, 157, 88, 0.35),
    transparent 70%
  );
  animation: flotar 20s ease-in-out infinite;
}

.mancha-2 {
  bottom: -18%;
  right: -12%;
  width: 620px;
  height: 620px;
  background: radial-gradient(
    circle,
    rgba(134, 239, 172, 0.45),
    transparent 70%
  );
  animation: flotar 25s ease-in-out infinite reverse;
}

.mancha-3 {
  top: 40%;
  left: 55%;
  width: 420px;
  height: 420px;
  background: radial-gradient(
    circle,
    rgba(234, 245, 238, 0.95),
    transparent 70%
  );
  animation: flotar 22s ease-in-out infinite 5s;
}

.mancha-4 {
  top: 8%;
  right: 15%;
  width: 340px;
  height: 340px;
  background: radial-gradient(
    circle,
    rgba(190, 242, 100, 0.3),
    transparent 70%
  );
  animation: flotar 18s ease-in-out infinite 2s;
}

@keyframes flotar {
  0%,
  100% {
    transform: translate(0, 0) scale(1);
  }
  33% {
    transform: translate(30px, -30px) scale(1.05);
  }
  66% {
    transform: translate(-20px, 20px) scale(0.95);
  }
}

/* Spinner minimalista */
@keyframes spin {
  to {
    transform: rotate(360deg);
  }
}

/* Animación de fade lateral (para el carrusel de votación) */
@keyframes entrar-lateral {
  from {
    opacity: 0;
    transform: translateX(16px);
  }
  to {
    opacity: 1;
    transform: translateX(0);
  }
}

/* ── Layout ── */
.contenedor {
  max-width: 720px;
  margin: 0 auto;
  padding: 48px 20px 80px;
  position: relative;
  z-index: 1;
}

/* ── Marca / Logo ── */
.marca {
  display: flex;
  align-items: center;
  gap: 10px;
  font-family: var(--font-fraunces), serif;
  font-weight: 600;
  font-size: 1rem;
  color: var(--acento);
  margin-bottom: 24px;
  letter-spacing: -0.01em;
}

.marca .punto {
  width: 10px;
  height: 10px;
  border-radius: 50%;
  background: var(--acento);
  display: inline-block;
  box-shadow: 0 0 0 4px var(--acento-suave);
  animation: pulso 2.4s ease-in-out infinite;
}

@keyframes pulso {
  0%, 100% { box-shadow: 0 0 0 4px var(--acento-suave); }
  50% { box-shadow: 0 0 0 8px rgba(15, 157, 88, 0.06); }
}

/* ── Tipografía ── */
h1 {
  font-family: var(--font-fraunces), serif;
  font-weight: 600;
  font-size: clamp(2rem, 5vw, 2.8rem);
  letter-spacing: -0.025em;
  line-height: 1.05;
  margin: 0 0 12px;
  color: var(--texto);
}

h1::after {
  content: "";
  display: block;
  width: 48px;
  height: 4px;
  background: linear-gradient(90deg, var(--acento), transparent);
  border-radius: 999px;
  margin-top: 16px;
}

h2 {
  font-family: var(--font-fraunces), serif;
  font-weight: 500;
  font-size: 1.35rem;
  margin: 0 0 6px;
  color: var(--texto);
  letter-spacing: -0.01em;
}

.subtitulo {
  color: var(--texto-suave);
  margin: 0 0 32px;
  font-size: 1.05rem;
  line-height: 1.6;
  font-weight: 400;
}

/* ── Tarjetas Glassmorphism Premium ── */
.tarjeta {
  background: var(--cristal-bg);
  backdrop-filter: blur(24px);
  -webkit-backdrop-filter: blur(24px);
  border: 1px solid var(--cristal-borde);
  border-radius: var(--radio-lg);
  padding: 28px;
  margin-bottom: 20px;
  box-shadow: var(--sombra-cristal);
  transition:
    transform 0.3s ease,
    box-shadow 0.3s ease;
}

.tarjeta:hover {
  transform: translateY(-2px);
  box-shadow: var(--sombra-hover);
}

/* ── Botones ── */
button,
.boton-primario {
  background: var(--acento);
  color: var(--texto-invertido);
  border: none;
  padding: 14px 24px;
  border-radius: var(--radio-md);
  font-family: var(--font-manrope), sans-serif;
  font-weight: 600;
  font-size: 0.95rem;
  cursor: pointer;
  width: 100%;
  transition: all 0.2s ease;
}

button:hover,
.boton-primario:hover {
  background: var(--acento-hover);
  transform: translateY(-2px);
  box-shadow: 0 8px 24px rgba(15, 157, 88, 0.32);
}

button:active {
  transform: translateY(0) scale(0.98);
}

button:disabled {
  opacity: 0.4;
  cursor: not-allowed;
  transform: none;
  box-shadow: none;
}

.boton-secundario {
  background: transparent;
  color: var(--acento);
  border: 1.5px solid var(--acento-suave);
  padding: 14px 24px;
  border-radius: var(--radio-md);
  font-weight: 600;
  font-size: 0.95rem;
  cursor: pointer;
  width: 100%;
  transition: all 0.2s ease;
}

.boton-secundario:hover {
  background: var(--verde-niebla);
  border-color: var(--acento);
  transform: translateY(-1px);
}

/* ── Inputs ── */
.campo-input,
.campo-select {
  width: 100%;
  padding: 14px 16px;
  border-radius: var(--radio-md);
  border: 1px solid rgba(26, 26, 46, 0.08);
  background: var(--cristal-bg-fuerte);
  color: var(--texto);
  font-family: var(--font-manrope), sans-serif;
  font-size: 0.95rem;
  outline: none;
  transition: all 0.2s ease;
}

.campo-input:focus,
.campo-select:focus {
  border-color: rgba(26, 26, 46, 0.2);
  box-shadow: 0 0 0 4px rgba(26, 26, 46, 0.04);
}

.campo-input::placeholder {
  color: var(--texto-suave);
}

/* ── Filas de atributo (sliders) ── */
.fila-atributo {
  display: flex;
  align-items: center;
  gap: 16px;
  margin: 8px 0;
}

.fila-atributo label {
  width: 100px;
  font-size: 0.9rem;
  color: var(--texto-suave);
  font-weight: 500;
}

.fila-atributo input[type="range"] {
  flex: 1;
  -webkit-appearance: none;
  appearance: none;
  height: 6px;
  border-radius: 6px;
  background: rgba(15, 46, 28, 0.1);
  outline: none;
  cursor: pointer;
}

.fila-atributo input[type="range"]::-webkit-slider-thumb {
  -webkit-appearance: none;
  width: 22px;
  height: 22px;
  border-radius: 50%;
  background: var(--acento);
  border: 3px solid #fff;
  box-shadow: 0 2px 10px rgba(15, 157, 88, 0.4);
  cursor: pointer;
  transition: transform 0.15s ease;
}

.fila-atributo input[type="range"]::-webkit-slider-thumb:hover {
  transform: scale(1.18);
}

.fila-atributo input[type="range"]::-moz-range-thumb {
  width: 22px;
  height: 22px;
  border-radius: 50%;
  background: var(--acento);
  border: 3px solid #fff;
  box-shadow: 0 2px 10px rgba(15, 157, 88, 0.4);
  cursor: pointer;
}

.valor-atributo {
  width: 28px;
  text-align: right;
  font-weight: 700;
  color: var(--texto);
  font-variant-numeric: tabular-nums;
  font-size: 0.95rem;
}

/* ── Chips de posición (pastel pills) ── */
.chip {
  display: inline-flex;
  align-items: center;
  font-size: 0.65rem;
  font-weight: 700;
  padding: 4px 12px;
  border-radius: 999px;
  margin-left: 8px;
  letter-spacing: 0.04em;
  vertical-align: middle;
  text-transform: uppercase;
}

.chip-DEL {
  background: var(--del-bg);
  color: var(--del-texto);
}
.chip-EX {
  background: var(--del-bg);
  color: var(--del-texto);
}
.chip-MED {
  background: var(--med-bg);
  color: var(--med-texto);
}
.chip-MC {
  background: var(--med-bg);
  color: var(--med-texto);
}
.chip-MCD {
  background: var(--med-bg);
  color: var(--med-texto);
}
.chip-MP {
  background: var(--med-bg);
  color: var(--med-texto);
}
.chip-DEF {
  background: var(--def-bg);
  color: var(--def-texto);
}
.chip-DFC {
  background: var(--def-bg);
  color: var(--def-texto);
}
.chip-LD {
  background: var(--def-bg);
  color: var(--def-texto);
}
.chip-LI {
  background: var(--def-bg);
  color: var(--def-texto);
}
.chip-POR {
  background: var(--por-bg);
  color: var(--por-texto);
}

/* ── Grid de equipos ── */
.equipos-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 16px;
}

@media (max-width: 640px) {
  .equipos-grid {
    grid-template-columns: 1fr;
  }
}

/* ── Filas de jugador ── */
.jugador-fila {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 12px 0;
  border-bottom: 1px solid rgba(26, 26, 46, 0.06);
  font-size: 0.95rem;
}

.jugador-fila:last-child {
  border-bottom: none;
}

.total-equipo {
  font-family: var(--font-fraunces), serif;
  font-size: 1.2rem;
  font-weight: 600;
  text-align: center;
  margin-bottom: 16px;
  color: var(--texto);
  padding-bottom: 12px;
  border-bottom: 1px solid rgba(26, 26, 46, 0.06);
}

/* ── Links ── */
a {
  color: inherit;
  text-decoration: none;
}

/* ── Admin ── */
.link-jugador {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 14px 0;
  border-bottom: 1px solid rgba(26, 26, 46, 0.06);
  font-size: 0.9rem;
  word-break: break-all;
  gap: 12px;
}

.link-jugador:last-child {
  border-bottom: none;
}

.copiar-btn {
  width: auto;
  padding: 8px 16px;
  font-size: 0.8rem;
  white-space: nowrap;
  border-radius: var(--radio-sm);
  background: var(--cristal-bg-fuerte);
  color: var(--texto);
  border: 1px solid rgba(26, 26, 46, 0.08);
  font-weight: 600;
  cursor: pointer;
  transition: all 0.15s ease;
}

.copiar-btn:hover {
  background: var(--fondo-elevado);
  border-color: rgba(26, 26, 46, 0.15);
  transform: translateY(-1px);
}

/* ── Progreso ── */
.progreso {
  height: 6px;
  background: rgba(26, 26, 46, 0.06);
  border-radius: 6px;
  overflow: hidden;
  margin-bottom: 24px;
}

.progreso-relleno {
  height: 100%;
  background: var(--texto);
  border-radius: 6px;
  transition: width 0.4s cubic-bezier(0.4, 0, 0.2, 1);
}

/* ── Nota ── */
.nota {
  font-weight: 700;
  color: var(--texto);
  font-family: var(--font-fraunces), serif;
  font-size: 1.1rem;
}

/* ── Scrollbar elegante ── */
::-webkit-scrollbar {
  width: 8px;
}

::-webkit-scrollbar-track {
  background: transparent;
}

::-webkit-scrollbar-thumb {
  background: rgba(26, 26, 46, 0.15);
  border-radius: 4px;
}

::-webkit-scrollbar-thumb:hover {
  background: rgba(26, 26, 46, 0.25);
}

/* ── Animaciones de entrada ── */
@keyframes entrar {
  from {
    opacity: 0;
    transform: translateY(20px) scale(0.98);
  }
  to {
    opacity: 1;
    transform: translateY(0) scale(1);
  }
}

.animar-entrada {
  animation: entrar 0.6s cubic-bezier(0.4, 0, 0.2, 1) forwards;
}

.animar-retraso-1 {
  animation-delay: 0.1s;
  opacity: 0;
}
.animar-retraso-2 {
  animation-delay: 0.2s;
  opacity: 0;
}
.animar-retraso-3 {
  animation-delay: 0.35s;
  opacity: 0;
}

/* ── Check final (votación enviada) ── */
@keyframes checkPop {
  0% {
    opacity: 0;
    transform: scale(0.4) rotate(-10deg);
  }
  100% {
    opacity: 1;
    transform: scale(1) rotate(0);
  }
}

/* ── Shell de navegación (sidebar desktop + drawer móvil) ── */
:root {
  --sidebar-ancho: 252px;
  --barra-movil-alto: 60px;
}

.app-contenido {
  min-height: 100vh;
  padding-top: var(--barra-movil-alto);
  position: relative;
  z-index: 1;
}

/* ── Sidebar desktop (oculto en móvil) ── */
.sidebar {
  display: none;
}

.sidebar-marca {
  display: flex;
  align-items: center;
  gap: 10px;
  font-family: var(--font-fraunces), serif;
  font-weight: 600;
  font-size: 1rem;
  color: var(--acento);
  letter-spacing: -0.01em;
  padding: 4px 10px;
}

.sidebar-marca .punto {
  width: 10px;
  height: 10px;
  border-radius: 50%;
  background: var(--acento);
  display: inline-block;
  box-shadow: 0 0 0 4px var(--acento-suave);
  animation: pulso 2.4s ease-in-out infinite;
  flex-shrink: 0;
}

.sidebar-nav {
  display: flex;
  flex-direction: column;
  gap: 4px;
  margin-top: 28px;
}

.sidebar-item {
  display: flex;
  align-items: center;
  gap: 12px;
  padding: 12px 14px;
  border-radius: var(--radio-md);
  color: var(--texto-suave);
  font-weight: 600;
  font-size: 0.95rem;
  position: relative;
  transition:
    color 0.2s ease,
    background 0.2s ease;
}

.sidebar-item svg {
  flex-shrink: 0;
  transition: color 0.2s ease;
}

.sidebar-item:hover {
  color: var(--texto);
  background: var(--verde-niebla);
}

.sidebar-item.activa {
  color: var(--acento);
  background: var(--acento-suave);
}

.sidebar-item.activa::before {
  content: "";
  position: absolute;
  left: 0;
  top: 22%;
  bottom: 22%;
  width: 3px;
  border-radius: 999px;
  background: var(--acento);
  box-shadow: 0 0 8px var(--acento-glow);
}

.sidebar-pie {
  margin-top: auto;
  padding: 12px 10px 4px;
  font-size: 0.72rem;
  color: var(--texto-suave);
  border-top: 1px solid var(--cristal-borde);
}

/* ── Barra superior móvil ── */
.barra-movil {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  z-index: 90;
  height: var(--barra-movil-alto);
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 16px;
  background: var(--cristal-bg-fuerte);
  backdrop-filter: blur(18px);
  -webkit-backdrop-filter: blur(18px);
  border-bottom: 1px solid var(--cristal-borde);
}

.burger {
  width: auto;
  padding: 9px;
  border-radius: var(--radio-sm);
  background: var(--cristal-bg);
  border: 1px solid var(--cristal-borde);
  color: var(--texto);
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: none;
}

.burger:hover {
  background: var(--fondo-elevado);
  box-shadow: none;
  transform: none;
}

/* ── Drawer móvil ── */
.drawer-fondo {
  position: fixed;
  inset: 0;
  z-index: 100;
  background: rgba(15, 46, 28, 0.35);
  backdrop-filter: blur(2px);
  -webkit-backdrop-filter: blur(2px);
  animation: aparecer 0.2s ease-out both;
}

.drawer {
  position: fixed;
  top: 0;
  left: 0;
  bottom: 0;
  width: min(300px, 84vw);
  z-index: 110;
  background: var(--cristal-bg-fuerte);
  backdrop-filter: blur(24px);
  -webkit-backdrop-filter: blur(24px);
  border-right: 1px solid var(--cristal-borde);
  transform: translateX(-100%);
  transition: transform 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  padding: 20px 18px;
  display: flex;
  flex-direction: column;
  box-shadow: 20px 0 60px rgba(15, 46, 28, 0.15);
}

.drawer.abierto {
  transform: translateX(0);
}

.drawer-cabecera {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

@keyframes aparecer {
  from {
    opacity: 0;
  }
  to {
    opacity: 1;
  }
}

/* ── Desktop: sidebar fijo + contenido desplazado ── */
@media (min-width: 901px) {
  .barra-movil {
    display: none;
  }

  .app-contenido {
    padding-top: 0;
    margin-left: var(--sidebar-ancho);
  }

  .sidebar {
    display: flex;
    flex-direction: column;
    position: fixed;
    top: 0;
    left: 0;
    bottom: 0;
    width: var(--sidebar-ancho);
    padding: 26px 18px;
    background: var(--cristal-bg-fuerte);
    backdrop-filter: blur(24px);
    -webkit-backdrop-filter: blur(24px);
    border-right: 1px solid var(--cristal-borde);
    z-index: 50;
  }
}

/* ── Tarjetas de estadística (dashboard deportivo) ── */
.stat-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 12px;
  margin-bottom: 20px;
}

.stat-card {
  background: var(--cristal-bg);
  backdrop-filter: blur(24px);
  -webkit-backdrop-filter: blur(24px);
  border: 1px solid var(--cristal-borde);
  border-radius: var(--radio-md);
  padding: 18px 20px;
  box-shadow: var(--sombra-cristal);
  display: flex;
  flex-direction: column;
  justify-content: center;
  min-height: 96px;
}

.stat-card.principal {
  grid-column: span 2;
  border-radius: var(--radio-lg);
  padding: 22px 24px;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  gap: 16px;
  min-height: 120px;
  box-shadow: var(--sombra-hover);
}

.stat-etiqueta {
  font-size: 0.72rem;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 0.07em;
  color: var(--texto-suave);
  margin-bottom: 6px;
}

.stat-numero {
  font-family: var(--font-fraunces), serif;
  font-size: 2rem;
  font-weight: 700;
  color: var(--texto);
  line-height: 1;
  font-variant-numeric: tabular-nums;
}

.stat-sub {
  font-size: 0.78rem;
  color: var(--texto-suave);
  margin-top: 6px;
}

@media (min-width: 640px) {
  .stat-grid {
    grid-template-columns: repeat(4, 1fr);
  }
}

/* ── Admin grid horizontal ── */
.admin-contenedor {
  max-width: 1080px;
}

.admin-grid {
  display: grid;
  grid-template-columns: 1fr;
  gap: 16px;
  margin-bottom: 8px;
}

.admin-span-2 {
  grid-column: span 1;
}

@media (min-width: 720px) {
  .admin-grid {
    grid-template-columns: 1fr 1fr;
  }
  .admin-span-2 {
    grid-column: span 2;
  }
}

/* ── Barra de selección múltiple (bulk) ── */
.bulk-bar {
  position: fixed;
  bottom: 16px;
  left: 16px;
  right: 16px;
  z-index: 200;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12px;
  padding: 12px 16px;
  background: var(--cristal-bg-fuerte);
  backdrop-filter: blur(24px);
  -webkit-backdrop-filter: blur(24px);
  border: 1px solid var(--cristal-borde);
  border-radius: var(--radio-md);
  box-shadow: 0 12px 40px rgba(15, 46, 28, 0.18);
  animation: entrar 0.25s ease-out both;
  flex-wrap: wrap;
}

